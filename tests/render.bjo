;; bjosql/tests/render.bjo — what the statements render to. No database.
;;
;;     bjo run tests/render.bjo
;;
;; Every line should start with "ok:".

(import (std prelude))
(import (std simpletest))
(import (std datetime))
(import (std uuid))
(import (text json))
(import (bjosql core))

(def/table events Event
  (key Uuid #:primary-key)
  (day Date)
  (at Time)
  (local DateTime)
  (happened Instant)
  (price decimal)
  (doc JsonDoc)
  (total long)
  (note (Option Instant)))

(def/table settings Setting
  (key string #:primary-key)
  (value Json)
  (extra (Option Json)))

(: some-json (-> string Json))
(defun (some-json text)
  (match (parse-json text)
    ((Ok j) j)
    ((Err why) (panic! why))))

(: some! (-> (Option %a) %a))
(defun (some! o)
  (match o
    ((Some x) x)
    (None (panic! "expected a value"))))

(: noon Instant)
(def noon (some! (iso8601->instant "2026-10-12T12:00:00Z")))

;; The stored text of a value, as a database with no type for it keeps it.
(: stored (-> %v string) (where (ToSql %v)))
(defun (stored v)
  (match (stored-text (to-sql v))
    ((Some s) s)
    (None "none")))

;; `from-sql` at one type.
(: as-decimal (-> SqlValue (Result string decimal)))
(defun (as-decimal v) (from-sql v))

(: as-uuid (-> SqlValue (Result string Uuid)))
(defun (as-uuid v) (from-sql v))

(: as-date (-> SqlValue (Result string Date)))
(defun (as-date v) (from-sql v))

(: as-json (-> SqlValue (Result string Json)))
(defun (as-json v) (from-sql v))

;; Written as its stored text and read back: the same value.
;; `Ord` and not `Eq`: (bjosql core) has a test case named `Eq`.
(: back-from-text (-> %v bool) (where (ToSql %v) (FromSql %v) (Ord %v)))
(defun (back-from-text v)
  (match (from-sql (SqlText (stored v)))
    ((Ok w) (= (compare w v) 0))
    ((Err _) #f)))

(def/table users User
  (id int #:primary-key #:auto)
  (name string)
  (email (Option string))
  (age int))

;; Shares `id` and `name` with `users`. The values of a row are read with
;; `record-ref` in code `def/table` writes, which has to know which record.
(def/table tags Tag
  (id int #:primary-key)
  (name string))

(def/table memberships Membership #:sql-name "user_groups"
  (user int #:primary-key)
  (group string #:primary-key)
  (since string #:sql-type "TIMESTAMP"))

;; `$1`, `$2`: the placeholders are numbered in the order the values appear.
(: numbered Dialect)
(def numbered (record-set standard-dialect (placeholder (fun (n) (str "$" (int->string n))))))

(: show (-> Sql string))
(defun (show s)
  (def st (render numbered s))
  (def params (vec->list (statement-params st)))
  (if (empty? params)
      (statement-text st)
      (str (statement-text st) " | " (string-join (list->vec (list-map describe-sql-value params)) ", "))))

(: show-select (-> UserSelect string))
(defun (show-select q) (show (select->sql users q)))

(: show-change (-> UserChange string))
(defun (show-change c)
  (match (change->sql users c)
    ((Ok s) (show s))
    ((Err e) (str "error: " (sql-error-message e)))))

;; Fragments: a literal in a return position is read against the return type,
;; through `if` too.
(: named (-> string UserCond))
(defun (named who) '(name (= ,who)))

(: grown-ups (-> bool UserCond))
(defun (grown-ups strict?)
  (if strict? '(age (>= 21)) '(age (>= 18))))

(: find-user (-> string UserSelect))
(defun (find-user who)
  '(select (id name) (where (and ,(named who) ,(grown-ups #t))) (limit 1)))

(defun (main args)
  (def (: n int) 3)

  ;; --- select ---------------------------------------------------------------
  (expect "every column, written out"
          (show-select '(select))
          "SELECT \"id\", \"name\", \"email\", \"age\" FROM \"users\"")
  (expect "* is every column" (show-select '(select *)) (show-select '(select)))
  (expect "a projection and a condition"
          (show-select '(select (id name) (where (id (>= ,n)))))
          "SELECT \"id\", \"name\" FROM \"users\" WHERE \"id\" >= $1 | the integer 3")
  (expect "the logic"
          (show-select '(select (id) (where (or (and (age (between 18 65)) (name (like "A%")))
                                                (not (email is-null))))))
          (str "SELECT \"id\" FROM \"users\" WHERE ((\"age\" BETWEEN $1 AND $2 AND \"name\" LIKE $3)"
               " OR NOT (\"email\" IS NULL)) | the integer 18, the integer 65, the text \"A%\""))
  (expect "a nullable column takes every test as well as the null ones"
          (show-select '(select (id) (where (email (= "a@b.c")))))
          "SELECT \"id\" FROM \"users\" WHERE \"email\" = $1 | the text \"a@b.c\"")
  (expect "in"
          (show-select '(select (id) (where (id (in 1 2 3)))))
          "SELECT \"id\" FROM \"users\" WHERE \"id\" IN ($1, $2, $3) | the integer 1, the integer 2, the integer 3")
  (expect "an empty in holds nothing"
          (show-select '(select (id) (where (id (in)))))
          "SELECT \"id\" FROM \"users\" WHERE 1 = 0")
  (expect "several wheres are all of them"
          (show-select '(select (id) (where (id (> 1))) (where (age (< 9)))))
          "SELECT \"id\" FROM \"users\" WHERE (\"id\" > $1 AND \"age\" < $2) | the integer 1, the integer 9")
  (expect "order, limit and offset, whatever order they are written in"
          (show-select '(select (offset 20) (order-by name (desc id)) (limit 10) distinct (name)))
          "SELECT DISTINCT \"name\" FROM \"users\" ORDER BY \"name\", \"id\" DESC LIMIT $1 OFFSET $2 | the integer 10, the integer 20")
  (expect "an offset alone gets the dialect's limit that limits nothing"
          (render (record-set numbered (no-limit " LIMIT -1")) (select->sql users '(select (id) (offset 5))))
          (render numbered (sql "SELECT \"id\" FROM \"users\" LIMIT -1 OFFSET ?" (list (to-sql 5)))))
  (expect "fragments, built by functions"
          (show-select (find-user "ada"))
          (str "SELECT \"id\", \"name\" FROM \"users\" WHERE (\"name\" = $1 AND \"age\" >= $2) LIMIT $3"
               " | the text \"ada\", the integer 21, the integer 1"))
  (expect "SQL by hand inside a condition"
          (show-select '(select (id) (where (and (id (> 1)) ,(sql "length(name) > ?" (list (to-sql 2)))))))
          "SELECT \"id\" FROM \"users\" WHERE (\"id\" > $1 AND (length(name) > $2)) | the integer 1, the integer 2")

  ;; --- update and delete ------------------------------------------------------
  (expect "update"
          (show-change '(update (set (name "Ada") (email ,None)) (where (id (= 1)))))
          "UPDATE \"users\" SET \"name\" = $1, \"email\" = $2 WHERE \"id\" = $3 | the text \"Ada\", NULL, the integer 1")
  (expect "a nullable column is set from a value, null, or an Option"
          (show-change '(update (set (email "a@b.c") (email null) (email ,(Some "x")))))
          "UPDATE \"users\" SET \"email\" = $1, \"email\" = $2, \"email\" = $3 | the text \"a@b.c\", NULL, the text \"x\"")
  (expect "an update with nothing to set is refused"
          (show-change '(update (set) (where (id (= 1)))))
          "error: an update of users needs a (set ...) with something in it.")
  (expect "delete"
          (show-change '(delete (where (age (< 18)))))
          "DELETE FROM \"users\" WHERE \"age\" < $1 | the integer 18")
  (expect "delete everything" (show-change '(delete)) "DELETE FROM \"users\"")

  ;; --- insert and create --------------------------------------------------------
  (expect "insert leaves out the #:auto column, and returns the row"
          (show (insert->sql users (User (id 0) (name "Ada") (email None) (age 36))))
          (str "INSERT INTO \"users\" (\"name\", \"email\", \"age\") VALUES ($1, $2, $3)"
               " RETURNING \"id\", \"name\", \"email\", \"age\" | the text \"Ada\", NULL, the integer 36"))
  (expect "create table"
          (show (create-table->sql users))
          (str "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "
               "\"name\" TEXT NOT NULL, \"email\" TEXT, \"age\" INTEGER NOT NULL)"))
  (expect "a composite key, another SQL name and a type of one's own"
          (show (create-table->sql memberships))
          (str "CREATE TABLE IF NOT EXISTS \"user_groups\" (\"user\" INTEGER, \"group\" TEXT, "
               "\"since\" TIMESTAMP NOT NULL, PRIMARY KEY (\"user\", \"group\"))"))

  ;; --- sql by hand ----------------------------------------------------------------
  (expect "a ? in a string is text"
          (show (sql "SELECT '?' AS q, \"a?\" FROM t WHERE x = ?" (list (to-sql "y"))))
          "SELECT '?' AS q, \"a?\" FROM t WHERE x = $1 | the text \"y\"")
  (expect-true "too few values is the program's mistake"
               (match (try (sql "SELECT ?" Nil) #:catch (System.ArgumentException))
                 ((Err _) #t)
                 ((Ok _) #f)))

  ;; --- rows -----------------------------------------------------------------------
  (def row (make-row ["id" "name" "email" "age"]
                     [(SqlInt 7L) (SqlText "Ada") SqlNull (SqlInt 36L)]))
  (expect "a row is decoded by column name"
          (match (decode-row users row)
            ((Ok u) (str (int->string (record-ref u id)) " " (record-ref u name) " " (->str (record-ref u email))))
            ((Err e) (sql-error-message e)))
          "7 Ada None")
  (expect "a missing column is named"
          (match (decode-row users (make-row ["id"] [(SqlInt 7L)]))
            ((Ok _) "decoded")
            ((Err e) (sql-error-message e)))
          "the result has no column name.")
  (expect "a value of the wrong kind is named"
          (match (decode-row users (make-row ["id" "name" "email" "age"]
                                             [(SqlText "seven") (SqlText "Ada") SqlNull (SqlInt 1L)]))
            ((Ok _) "decoded")
            ((Err e) (sql-error-message e)))
          "column id: expected an integer, got the text \"seven\".")
  (expect "names are compared ignoring case when nothing matches exactly"
          (match (row-field (make-row ["COUNT"] [(SqlInt 2L)]) "count")
            ((Ok n) (long->string n))
            ((Err e) (sql-error-message e)))
          "2")

  ;; --- the types beyond the six ----------------------------------------------------
  (expect "create table, with the standard names"
          (show (create-table->sql events))
          (str "CREATE TABLE IF NOT EXISTS \"events\" (\"key\" UUID PRIMARY KEY, \"day\" DATE NOT NULL, "
               "\"at\" TIME NOT NULL, \"local\" TIMESTAMP NOT NULL, "
               "\"happened\" TIMESTAMP WITH TIME ZONE NOT NULL, \"price\" NUMERIC NOT NULL, "
               "\"doc\" JSON NOT NULL, \"total\" BIGINT NOT NULL, \"note\" TIMESTAMP WITH TIME ZONE)"))
  (expect "a test takes the column's type"
          (show (select->sql events '(select (key) (where (and (happened (>= ,noon)) (price (< 9.5M)))))))
          (str "SELECT \"key\" FROM \"events\" WHERE (\"happened\" >= $1 AND \"price\" < $2)"
               " | the instant 2026-10-12T12:00:00Z, the decimal 9.5"))

  (expect "the stored text"
          (vec-map (fun (v) (match (stored-text v) ((Some s) s) (None "none")))
                   [(to-sql (some! (date 2026 10 12)))
                    (to-sql (some! (date 99 1 2)))
                    (to-sql (some! (time 14 5 #:seconds 9)))
                    (to-sql (some! (datetime 2026 10 12 #:hours 14 #:minutes 5 #:seconds 9 #:nanoseconds 123456789)))
                    (to-sql (some! (iso8601->instant "2026-10-12T14:05:09.5+02:00")))
                    (to-sql -12.50M)
                    (to-sql uuid-ns-dns)
                    (to-sql (json-doc "{\"a\": 1}"))
                    (SqlOther "inet" "10.0.0.1")
                    (SqlInt 3L)])
          ["2026-10-12" "0099-01-02" "14:05:09.000000" "2026-10-12 14:05:09.123456"
           "2026-10-12 12:05:09.500000Z" "-12.50" "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
           "{\"a\": 1}" "10.0.0.1" "none"])

  (def precise (some! (datetime 2026 10 12 #:hours 14 #:nanoseconds 123456789)))
  (expect "to-sql keeps microseconds"
          (match (to-sql precise) ((SqlTimestamp t) (->nanoseconds t)) (_ -1))
          123456000)
  (expect "an instant too"
          (match (to-sql (some! (iso8601->instant "2026-10-12T14:00:00.1234567Z")))
            ((SqlInstant i) (->nanoseconds (instant->utc-datetime i)))
            (_ -1))
          123456000)

  (expect "each type reads back from its stored text"
          (list (back-from-text (some! (date 2026 10 12)))
                (back-from-text (some! (time 14 5 #:seconds 9 #:nanoseconds 250000000)))
                (back-from-text (some! (datetime 2026 10 12 #:hours 14 #:nanoseconds 123456000)))
                (back-from-text noon)
                (back-from-text -12.50M)
                (back-from-text uuid-ns-dns))
          (list #t #t #t #t #t #t))
  (expect "a decimal keeps its scale through the text"
          (match (as-decimal (SqlText "12.50")) ((Ok d) (decimal->string d)) ((Err e) e))
          "12.50")
  (expect "an integer is a decimal"
          (match (as-decimal (SqlInt 12L)) ((Ok d) (decimal->string d)) ((Err e) e))
          "12")
  (expect "a real is not a decimal"
          (match (as-decimal (SqlReal 1.5)) ((Ok _) "read") ((Err e) e))
          "expected a decimal, got the real 1.5")
  (expect "a uuid from 16 bytes"
          (match (as-uuid (SqlBlob (uuid->bytes uuid-ns-url))) ((Ok u) (= u uuid-ns-url)) ((Err e) #f))
          #t)
  (expect "text that is not a date"
          (match (as-date (SqlText "12/10/2026")) ((Ok _) "read") ((Err e) e))
          "expected a date, got the text \"12/10/2026\"")
  (expect "JSON is parsed"
          (match (as-json (SqlJson "{\"a\": [1, 2]}")) ((Ok _) "parsed") ((Err e) e))
          "parsed")

  (expect "the stored text sorts as the instants do, whatever their fraction"
          (let ((times (list (some! (iso8601->instant "2026-10-12T09:00:00.5Z"))
                             (some! (iso8601->instant "2026-10-12T09:00:00.25Z"))
                             (some! (iso8601->instant "2026-10-12T09:00:00Z"))
                             (some! (iso8601->instant "2026-10-12T10:00:00+02:00")))))
            (= (list-map stored (list-sort times))
               (list-sort (list-map stored times))))
          #t)

  (expect "a row of the new types decodes from stored text"
          (match (decode-row events
                             (make-row ["key" "day" "at" "local" "happened" "price" "doc" "total" "note"]
                                       [(SqlText "6ba7b810-9dad-11d1-80b4-00c04fd430c8") (SqlText "2026-10-12")
                                        (SqlText "14:05:09.000000") (SqlText "2026-10-12 14:05:09.000000")
                                        (SqlText "2026-10-12 12:00:00.000000Z") (SqlText "9.50")
                                        (SqlText "[]") (SqlInt 5L) SqlNull]))
            ((Ok e) (str (->str (record-ref e key)) " " (decimal->string (record-ref e price))
                         " " (->str (record-ref e happened))))
            ((Err e) (sql-error-message e)))
          "6ba7b810-9dad-11d1-80b4-00c04fd430c8 9.50 2026-10-12T12:00:00Z")

  (expect "two tables with fields of the same name"
          (show (insert->sql tags (Tag (id 1) (name "knee"))))
          (str "INSERT INTO \"tags\" (\"id\", \"name\") VALUES ($1, $2) RETURNING \"id\", \"name\""
               " | the integer 1, the text \"knee\""))

  ;; --- Json columns ---------------------------------------------------------------------
  (def tree (some-json "{\"b\": [true, 2.0], \"a\": \"knee\"}"))
  (expect "a Json column is JSON"
          (show (create-table->sql settings))
          "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT PRIMARY KEY, \"value\" JSON NOT NULL, \"extra\" JSON)")
  (expect "a Json is sent as compact text, its keys sorted"
          (show (insert->sql settings (Setting (key "k") (value tree) (extra None))))
          (str "INSERT INTO \"settings\" (\"key\", \"value\", \"extra\") VALUES ($1, $2, $3)"
               " RETURNING \"key\", \"value\", \"extra\""
               " | the text \"k\", the JSON {\"a\":\"knee\",\"b\":[true,2.0]}, NULL"))
  (expect "a row reads back into a Json"
          (match (decode-row settings (make-row ["key" "value" "extra"]
                                                [(SqlText "k") (SqlJson "{\"b\": 1, \"a\": [null]}") SqlNull]))
            ((Ok s) (json->string (record-ref s value)))
            ((Err e) (sql-error-message e)))
          "{\"a\":[null],\"b\":1}")

  ;; --- a cast for SqlOther ------------------------------------------------------------
  (expect "the standard dialect writes no cast"
          (statement-text (render numbered (sql "SELECT ?" (list (SqlOther "inet" "10.0.0.1")))))
          "SELECT $1")
  (expect "a dialect with postgres-style-cast does"
          (statement-text (render (record-set numbered (param-cast postgres-style-cast))
                                  (sql "SELECT ? WHERE ? > 1" (list (SqlOther "inet" "10.0.0.1") (SqlInt 2L)))))
          "SELECT $1::inet WHERE $2 > 1")
  0)
